# Copy this file to .env and fill in YOUR values. Never commit .env, and never put real secrets in this file.

# Neon: use the direct connection string (host WITHOUT "-pooler") so Prisma migrations work.
DATABASE_URL=

GROQ_API_KEY=
GROQ_MODEL=

# Not used by Vidscript yet (kept from the original spec)
LAFZALY_API_URL=
LAFZALY_API_KEY=

# Backblaze B2 (S3-compatible). Planned for a later phase; not used yet.
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

REMOTION_RENDER_MODE=local
REMOTION_LAMBDA_REGION=
REMOTION_LAMBDA_FUNCTION_NAME=
REMOTION_SERVE_URL=
REMOTION_LAMBDA_MEMORY_MB=2048
REMOTION_LAMBDA_TIMEOUT_SECONDS=240

# Local dev only until real auth exists: any text, for example dev-user
DEV_USER_ID=

# Where renders and uploads are written (default ./storage)
STORAGE_DIR=

# Free stock photo/video APIs (get keys at pexels.com/api and pixabay.com/api/docs). Wikimedia Commons photos need no key.
PEXELS_API_KEY=
PIXABAY_API_KEY=

# Address the renderer uses to fetch stored assets (default http://localhost:3000)
APP_URL=

# Identifies your app to Wikimedia/Pexels, e.g. "Vidscript/0.1 (you@example.com)"
ASSET_USER_AGENT=

# Sign-in (needed online; create both with: npm run auth:setup)
OWNER_PASSWORD_HASH=
AUTH_SECRET=
# Which user owns your projects. Use dev-user to keep projects made in local development.
OWNER_USER_ID=owner
OWNER_EMAIL=
